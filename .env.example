# OpenRouter — una API key, acceso a Claude/GPT/Gemini con fallbacks
OPENROUTER_API_KEY=sk-or-...
# Modelo por defecto: GPT-5.5 (1º del benchmark frontend 2026)
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.5
OPENROUTER_FALLBACK_MODELS=anthropic/claude-opus-4.7,anthropic/claude-sonnet-4.6,google/gemini-3.1-pro-preview

# Identificación opcional en rankings de OpenRouter
OPENROUTER_SITE_URL=https://brandme-concept.up.railway.app
OPENROUTER_SITE_NAME=BrandMe Concept

# Extracción (Playwright corre completo dentro del contenedor)
EXTRACT_TIMEOUT_MS=30000

# Anti-abuso / protección de tokens
# IMPORTANTE: pon un LÍMITE DE GASTO a la API key en el dashboard de OpenRouter
# (es el tope DURO de dinero — ver README, sección Seguridad).
#
# Desde WO-7 (EP-07) los tunables anti-abuso YA NO se leen de env: viven en la
# tabla platform_config (editable sin deploy; defaults sembrados por migración).
# Si tenías LLM_DAILY_CAP / EXTRACT_CONCURRENCY / RL_*_PER_MIN en Railway,
# quítalas — no tienen ningún efecto. Ajustes: UPDATE a platform_config
# (admin UI en Build 6) o migración.
# DATABASE_URL            → rol de runtime brandme_app (sin DDL, sin BYPASSRLS)
# DATABASE_URL_MIGRATIONS → rol brandme_migrator, SOLO para pnpm db:migrate

# Voz (entrada/salida): STT para transcribir lo que dictas + TTS para leer respuestas.
# Por defecto REUSA la misma OPENROUTER_API_KEY de arriba (OpenRouter ya hace audio con
# API compatible-OpenAI) → no necesitas otra clave y funciona en prod sin config extra.
# Modelos configurables (ids de OpenRouter, con prefijo de proveedor):
# AUDIO_STT_MODEL=openai/whisper-1        # o groq/whisper-large-v3-turbo (rápido/barato)
# AUDIO_TTS_MODEL=openai/gpt-4o-mini-tts  # o google/gemini-flash-tts
# AUDIO_TTS_VOICE=alloy
# Alternativa: si prefieres OpenAI DIRECTO, define OPENAI_API_KEY (tendrá prioridad solo
# si NO hay OPENROUTER_API_KEY) y usa ids sin prefijo (whisper-1, gpt-4o-mini-tts).
# OPENAI_API_KEY=sk-...

# URL pública del sitio (OBLIGATORIA en producción): Stripe redirige aquí tras el pago.
# Si cae a localhost en prod, los success/cancel del Checkout se rompen.
NEXT_PUBLIC_SITE_URL=https://brandme-concept.up.railway.app

# Stripe — suscripción mensual para publicar. Sin estas claves, publicar es gratis
# (gate de pago desactivado; ideal para desarrollo local).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # del `stripe listen` o del dashboard (endpoint webhook)
STRIPE_PRICE_ID=price_...          # price recurrente mensual del producto

# Firebase — Auth (Google/email) + Analytics. Config PÚBLICA (segura en cliente,
# va en el bundle). Login OPCIONAL: sin estas vars, la app funciona anónima como
# siempre. En Railway agrégalas como variables del servicio (se inyectan en runtime).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=   # opcional, habilita Analytics (GA4)

# ── Agentes 8090 (Builds 3-4+): keys pendientes de provisionar ────────────────
# Cada una desbloquea WOs concretos (detalle en docs/EXECUTION-LOG.md y en los
# comentarios flaggeados de cada WO en 8090). El loop del agente detecta la
# aparición de estas keys en .env.local y ejecuta el WO automáticamente.

# Census ACS (GRATIS, api.census.gov/data/key_signup.html) → WO-18 Territory
CENSUS_API_KEY=

# Resend (email transaccional, tier gratis) → WO-19 Leads + Email (Fase 5)
RESEND_API_KEY=

# Voyage AI (embeddings; decisión formal de modelo/dims pendiente) → WO-14 RAG → WO-16 AMA
VOYAGE_API_KEY=

# Firecrawl (transporte target del scraping del Agente 02, ADR-001 de Brand Extraction)
FIRECRAWL_API_KEY=

# Trigger.dev (Task Server real: jobs async/programados) → WO-12 Onboarding
TRIGGER_SECRET_KEY=

# DataForSEO (keyword data del Agente 05; gates de Shawn pendientes) → WO-17
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
